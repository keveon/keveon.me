---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { postsInLead, t } from "../i18n/ui";
import { localeHref } from "../utils/routing";

const slug = decodeSlug(Astro.params.slug);
const copy = t(Astro.currentLocale);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
	locale: Astro.currentLocale,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) Astro.response.status = 404;

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = term
	? await getEmDashCollection("posts", {
			locale: Astro.currentLocale,
			where: { tag: term.slug },
			orderBy: { published_at: "desc" },
			limit: 20,
			cursor,
		})
	: { entries: [], cacheHint: termsResult.cacheHint, nextCursor: undefined };

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post tagged with this term,
// rather than calling getEntryTerms() per post.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	{ locale: Astro.currentLocale },
);
const archiveHref = localeHref(Astro.currentLocale, "/posts");
const tagHref = term
	? localeHref(Astro.currentLocale, `/tag/${term.slug}`)
	: localeHref(Astro.currentLocale, "/posts");
const filteredPosts = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).filter(
		(item) => item.slug !== term?.slug,
	),
}));
---

{
	!term && (
		<Base title={copy.pageNotFound}>
			<section class="band section">
				<div class="frame empty-state">
					<h1 class="empty-state__title">{copy.pageNotFound}</h1>
					<p class="empty-state__text">{copy.pageNotFoundLead}</p>
					<a class="btn" href={localeHref(Astro.currentLocale, "/")}>{copy.goHome}</a>
				</div>
			</section>
		</Base>
	)
}
{
	term && (
<Base title={term.label} description={postsInLead(Astro.currentLocale, term.label, term.description)}>
	<header class="band intro">
		<div class="frame archive-intro">
			<div class="archive-intro__text">
				<p class="eyebrow">{copy.tag}</p>
				<h1 class="intro__title">{term.label}</h1>
				<p class="intro__lead">
					{postsInLead(Astro.currentLocale, term.label, term.description)}
				</p>
			</div>
			<a href={archiveHref} class="arrow-link">
				{copy.allPosts}
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			{
				filteredPosts.length > 0 ? (
					<>
						<div class="post-grid">
							{filteredPosts.map(({ post, tags }) => (
								<PostCard
									post={post}
									tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
								/>
							))}
						</div>
						<Pagination
							basePath={tagHref}
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				) : (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? copy.noMorePosts : copy.nothingHere}
						</h2>
						<p class="empty-state__text">
							{cursor ? copy.pastLast : postsInLead(Astro.currentLocale, term.label)}
						</p>
						<div class="empty-state__actions">
							<a href={cursor ? tagHref : archiveHref} class="btn btn--ghost">
								{cursor ? copy.backToStart : copy.browsePosts}
							</a>
						</div>
					</div>
				)
			}
		</div>
	</section>
</Base>
	)
}

<style>
	.archive-intro {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		align-items: last baseline;
		justify-content: space-between;
		gap: var(--spacing-5) var(--spacing-10);
	}

	.archive-intro__text {
		min-width: 0;
	}
</style>
