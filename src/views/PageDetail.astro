---
import {
	getEmDashEntry,
	getSeoMeta,
	getTranslations,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { localeHref } from "../utils/routing";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/prose.css";

import { t } from "../i18n/ui";

const copy = t(Astro.currentLocale);
const slug = decodeSlug(Astro.params.slug);
const loaded = slug
	? await getEmDashEntry("pages", slug, { locale: Astro.currentLocale })
	: { entry: null, cacheHint: undefined };
const page = loaded.entry;
if (!page) Astro.response.status = 404;
if (page && loaded.cacheHint && Astro.cache?.enabled) Astro.cache.set(loaded.cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = page
	? getSeoMeta(page, {
			siteTitle,
			siteUrl: Astro.url.origin,
			path: Astro.url.pathname.replace(/\/$/, ""),
		})
	: null;

const alternates: Partial<Record<"zh" | "en", string>> = {};
if (page) {
	const { translations } = await getTranslations("pages", page.data.id);
	for (const translation of translations) {
		if (translation.status !== "published" || !translation.slug) continue;
		if (translation.locale === "zh" || translation.locale === "en") {
			alternates[translation.locale] = localeHref(
				translation.locale,
				`/pages/${translation.slug}`,
			);
		}
	}
}
---

{
	!page && (
		<Base title={copy.pageNotFound}>
			<section class="band section">
				<div class="frame empty-state">
					<h1 class="empty-state__title">{copy.pageNotFound}</h1>
					<p class="empty-state__text">{copy.pageNotFoundLead}</p>
					<a class="btn" href={localeHref(Astro.currentLocale, "/")}>{copy.goHome}</a>
				</div>
			</section>
		</Base>
	)
}
{
	page && seo && (
<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
	alternates={alternates}
>
	<article class="band page">
		<div class="frame page__layout">
			<header class="page__header">
				<h1 class="page__title" {...page.edit.title}>{page.data.title}</h1>
			</header>

			<div class="prose page__body" {...page.edit.content}>
				<PortableText value={page.data.content} />
			</div>
		</div>
	</article>
</Base>
	)
}

<style>
	.page {
		padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(4rem, 3rem + 4vw, 7rem);
	}

	.page__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-8);
	}

	.page__title {
		font-size: var(--font-size-display);
		line-height: 1.05;
		max-width: 22ch;
	}

	@media (min-width: 960px) {
		.page__layout {
			grid-template-columns: minmax(14rem, 1fr) minmax(0, var(--content-width));
			column-gap: clamp(2rem, 1rem + 4vw, 6rem);
		}

		.page__header {
			position: sticky;
			top: calc(var(--nav-height) + var(--spacing-8));
			align-self: start;
		}
	}
</style>
