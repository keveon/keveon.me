---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { originKind, originLabel, t } from "../i18n/ui";
import { contentSlug, entryPath, hostOf } from "../utils/routing";

interface Props {
	product: ContentEntry<InferCollectionData<"products">>;
	variant?: "feature" | "tile";
	tone?: number;
	headingLevel?: 2 | 3;
	priority?: boolean;
}

const {
	product,
	variant = "tile",
	tone = 0,
	headingLevel = 3,
	priority = false,
} = Astro.props;

const copy = t(Astro.currentLocale);
const Heading = `h${headingLevel}` as const;
const slug = contentSlug(product);
const href = entryPath(Astro.currentLocale, "products", slug);
const title = product.data.title || copy.untitled;
const kicker = hostOf(product.data.url);
const origin = originKind(product.data.origin);
const cta = product.data.url ? copy.open : copy.look;
const mark = [...title.trim()][0] ?? "";
---

<a class:list={["work", `work--${variant}`, `work--tone-${tone % 6}`]} href={href}>
	<div class="work__plate">
		{
			origin && (
				<span class:list={["origin-ribbon", `origin-ribbon--${origin}`]}>
					<span>{originLabel(Astro.currentLocale, origin)}</span>
				</span>
			)
		}
		{
			product.data.cover?.src || product.data.cover?.id ? (
				<div class="work__image" {...product.edit.cover}>
					<Image
						image={product.data.cover}
						alt={product.data.cover.alt || title}
						sizes={
							variant === "feature"
								? "(min-width: 900px) 640px, 100vw"
								: "(min-width: 1080px) 420px, 100vw"
						}
						priority={priority}
					/>
				</div>
			) : (
				<span class="work__mark" aria-hidden="true">
					{mark}
				</span>
			)
		}
	</div>
	<div class="work__body">
		{kicker && <p class="work__kicker">{kicker}</p>}
		<Heading class="work__title" {...product.edit.title}>{title}</Heading>
		{
			product.data.summary && (
				<p class="work__summary" {...product.edit.summary}>
					{product.data.summary}
				</p>
			)
		}
		<span class="work__cta">
			{cta}
			<span class="work__chevron" aria-hidden="true">→</span>
		</span>
	</div>
</a>

<style>
	.work {
		display: flex;
		flex-direction: column;
		min-height: 340px;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 22px;
		background: var(--color-surface);
		color: inherit;
		text-decoration: none;
		box-shadow: var(--shadow-card);
		transition:
			transform 240ms var(--ease-out),
			box-shadow 240ms var(--ease-out);
	}

	.work:hover {
		transform: translateY(-6px) scale(1.012);
		box-shadow: var(--shadow-card-hover);
	}

	.work:hover .work__chevron {
		transform: translateX(4px);
	}

	.work--feature {
		min-height: 440px;
	}

	.work__plate {
		position: relative;
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		min-height: 180px;
		padding: 1.25rem;
		overflow: hidden;
	}

	.work--tone-0 .work__plate {
		background: linear-gradient(160deg, #e8eef5 0%, #d9e4f0 55%, #c9d7e8 100%);
	}
	.work--tone-1 .work__plate {
		background: linear-gradient(165deg, #ede8f7 0%, #ddd4f0 50%, #c9bbe6 100%);
	}
	.work--tone-2 .work__plate {
		background: linear-gradient(160deg, #e7f0ec 0%, #d3e5dc 100%);
	}
	.work--tone-3 .work__plate {
		background: linear-gradient(165deg, #f8ede4 0%, #f0d5c0 55%, #e8c4a8 100%);
	}
	.work--tone-4 .work__plate {
		background: linear-gradient(160deg, #eceae6 0%, #ddd9d2 100%);
	}
	.work--tone-5 .work__plate {
		background: linear-gradient(160deg, #e4e8ec 0%, #cfd6de 100%);
	}

	:root.dark .work--tone-0 .work__plate {
		background: radial-gradient(at 30% 20%, #2a3548 0%, #1a2030 45%, #12151c 100%);
	}
	:root.dark .work--tone-1 .work__plate {
		background: radial-gradient(at 70% 10%, #3a2f52 0%, #221c32 50%, #16141f 100%);
	}
	:root.dark .work--tone-2 .work__plate {
		background: radial-gradient(at 40% 30%, #2a3a32 0%, #1a221e 60%, #121816 100%);
	}
	:root.dark .work--tone-3 .work__plate {
		background: radial-gradient(at 60% 20%, #4a3228 0%, #2a1e18 55%, #18120f 100%);
	}
	:root.dark .work--tone-4 .work__plate {
		background: radial-gradient(at 40% 30%, #2c2c30 0%, #1a1a1e 60%, #121214 100%);
	}
	:root.dark .work--tone-5 .work__plate {
		background: radial-gradient(at 50% 20%, #243040 0%, #161c24 55%, #101418 100%);
	}

	@media (prefers-color-scheme: dark) {
		:root:not(.light) .work--tone-0 .work__plate {
			background: radial-gradient(at 30% 20%, #2a3548 0%, #1a2030 45%, #12151c 100%);
		}
		:root:not(.light) .work--tone-1 .work__plate {
			background: radial-gradient(at 70% 10%, #3a2f52 0%, #221c32 50%, #16141f 100%);
		}
		:root:not(.light) .work--tone-2 .work__plate {
			background: radial-gradient(at 40% 30%, #2a3a32 0%, #1a221e 60%, #121816 100%);
		}
		:root:not(.light) .work--tone-3 .work__plate {
			background: radial-gradient(at 60% 20%, #4a3228 0%, #2a1e18 55%, #18120f 100%);
		}
		:root:not(.light) .work--tone-4 .work__plate {
			background: radial-gradient(at 40% 30%, #2c2c30 0%, #1a1a1e 60%, #121214 100%);
		}
		:root:not(.light) .work--tone-5 .work__plate {
			background: radial-gradient(at 50% 20%, #243040 0%, #161c24 55%, #101418 100%);
		}
	}

	.work__image,
	.work__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 12px;
	}

	.work__image {
		position: absolute;
		inset: 0.75rem;
	}

	.work__mark {
		font-size: 2.5rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: var(--color-brand);
		opacity: 0.85;
	}

	.work__body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.25rem 1.35rem 1.4rem;
	}

	.work__kicker {
		margin: 0;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.14em;
		color: var(--color-muted);
	}

	/* Paper corner ribbon: clipped into the plate corner. */
	.origin-ribbon {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 5;
		width: 88px;
		height: 88px;
		overflow: hidden;
		pointer-events: none;
	}

	.origin-ribbon > span {
		position: absolute;
		top: 16px;
		right: -30px;
		width: 116px;
		text-align: center;
		transform: rotate(45deg);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.14em;
		line-height: 1;
		padding: 5px 0;
		border: 1px solid transparent;
		box-shadow: 0 1px 2px rgba(20, 16, 12, 0.07);
	}

	.origin-ribbon--built > span {
		background: #1a1a1c;
		color: #fffefa;
	}

	.origin-ribbon--hosted > span {
		background: #fffefa;
		color: #3d5a80;
		border-color: rgba(61, 90, 128, 0.14);
		box-shadow: 0 1px 2px rgba(61, 90, 128, 0.07);
	}

	.origin-ribbon--soon > span {
		background: rgba(255, 254, 250, 0.86);
		color: rgba(26, 26, 28, 0.48);
		border: 1px dashed rgba(26, 26, 28, 0.18);
		box-shadow: none;
	}

	.origin-ribbon > span::before,
	.origin-ribbon > span::after {
		content: "";
		position: absolute;
		top: 100%;
		width: 0;
		height: 0;
		border-style: solid;
		box-sizing: content-box;
	}

	.origin-ribbon > span::before {
		left: 0;
		border-width: 0 7px 7px 0;
		border-color: transparent rgba(20, 16, 12, 0.22) transparent transparent;
	}

	.origin-ribbon > span::after {
		right: 0;
		border-width: 0 0 7px 7px;
		border-color: transparent transparent transparent rgba(20, 16, 12, 0.22);
	}

	.origin-ribbon--hosted > span::before {
		border-color: transparent rgba(61, 90, 128, 0.22) transparent transparent;
	}

	.origin-ribbon--hosted > span::after {
		border-color: transparent transparent transparent rgba(61, 90, 128, 0.22);
	}

	.origin-ribbon--soon > span::before,
	.origin-ribbon--soon > span::after {
		opacity: 0.45;
	}

	.work__title {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.2;
	}

	.work--feature .work__title {
		font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.125rem);
	}

	.work__summary {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.work__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.65rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-text);
	}

	.work__chevron {
		display: inline-block;
		transition: transform 220ms var(--ease-out);
	}

	@media (min-width: 768px) {
		.work--feature {
			flex-direction: row;
			min-height: 480px;
		}

		.work--feature .work__plate {
			width: 58%;
			min-height: 480px;
		}

		.work--feature .work__body {
			width: 42%;
			justify-content: center;
			padding: 2.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.work:hover {
			transform: none;
		}
	}
</style>
