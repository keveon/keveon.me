---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { t } from "../i18n/ui";
import { formatDate } from "../utils/locale";
import { contentSlug, entryPath, localeHref } from "../utils/routing";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const copy = t(Astro.currentLocale);
const [{ entries: products, cacheHint: productsHint }, { entries: posts, cacheHint: postsHint }, settings] =
	await Promise.all([
		getEmDashCollection("products", { locale: Astro.currentLocale, limit: 24 }),
		getEmDashCollection("posts", {
			locale: Astro.currentLocale,
			orderBy: { published_at: "desc" },
			limit: 3,
		}),
		getSiteSettings(),
	]);
if (Astro.cache?.enabled) {
	Astro.cache.set(productsHint);
	Astro.cache.set(postsHint);
}

const ordered = [...products].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const featured = ordered[0];
const rest = ordered.slice(1);
const spans = ["span-7", "span-5", "span-4", "span-4", "span-4"];
const { siteTagline } = resolveBlogSiteIdentity(settings);
const notesHref = localeHref(Astro.currentLocale, "/posts");
const worksHref = localeHref(Astro.currentLocale, "/products");
---

<Base title={copy.homeDocumentTitle} description={siteTagline || copy.homeLead}>
	<header class="hub-hero">
		<p class="hub-eyebrow">{copy.homeEyebrow}</p>
		<h1>{copy.homeTitle}</h1>
		<p class="hub-lead">{copy.homeLead}</p>
	</header>

	{
		featured && (
			<section class="hub-block" aria-labelledby="featured-work">
				<h2 id="featured-work" class="section-label">
					{copy.featured}
				</h2>
				<ProductCard product={featured} variant="feature" tone={0} headingLevel={2} priority />
			</section>
		)
	}

	<section class="hub-block" aria-labelledby="all-work">
		<div class="section-row">
			<h2 id="all-work" class="section-label">
				{copy.works}
			</h2>
			{
				rest.length > 0 && (
					<a class="section-more" href={worksHref}>
						{copy.viewAll} <span aria-hidden="true">→</span>
					</a>
				)
			}
		</div>
		{
			ordered.length === 0 ? (
				<div class="hub-empty">
					<h3>{copy.emptyWorksTitle}</h3>
					<p>{copy.emptyWorksText}</p>
					<a class="hub-btn" href="/_emdash/admin/content/products/new">
						{copy.emptyWorksAction}
					</a>
				</div>
			) : (
				rest.length > 0 && (
					<div class="work-grid">
						{rest.map((product, index) => (
							<div class:list={["work-grid__item", spans[index % spans.length]]}>
								<ProductCard product={product} tone={index + 1} headingLevel={3} />
							</div>
						))}
					</div>
				)
			)
		}
	</section>

	{
		posts.length > 0 && (
			<section class="hub-block hub-now" aria-labelledby="now-notes">
				<div class="section-row">
					<h2 id="now-notes" class="section-label">
						{copy.now}
					</h2>
					<a class="section-more" href={notesHref}>
						{copy.viewAll} <span aria-hidden="true">→</span>
					</a>
				</div>
				<div class="now-list">
					{posts.map((post) => (
						<a class="now-row" href={entryPath(Astro.currentLocale, "posts", contentSlug(post))}>
							<div>
								{post.data.publishedAt && (
									<time datetime={post.data.publishedAt.toISOString()}>
										{formatDate(post.data.publishedAt, "short", Astro.currentLocale)}
									</time>
								)}
								<strong {...post.edit.title}>{post.data.title}</strong>
								{post.data.excerpt && <span {...post.edit.excerpt}>{post.data.excerpt}</span>}
							</div>
							<span class="now-chevron" aria-hidden="true">
								→
							</span>
						</a>
					))}
				</div>
			</section>
		)
	}

	<section class="hub-about" aria-labelledby="about-keveon">
		<h2 id="about-keveon" class="section-label">
			{copy.aboutHeading}
		</h2>
		<p>{copy.aboutBlurb}</p>
	</section>
</Base>

<style>
	.hub-hero {
		max-width: 40rem;
		padding-block: clamp(4rem, 2.5rem + 4vw, 5rem) 2.5rem;
	}

	.hub-eyebrow,
	.section-label {
		margin: 0;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.hub-eyebrow {
		margin-bottom: 1rem;
		font-size: 12px;
		letter-spacing: 0.18em;
	}

	.hub-hero h1 {
		margin: 0;
		font-size: clamp(2.5rem, 1.2rem + 3.4vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.08;
	}

	.hub-lead,
	.hub-about p,
	.hub-empty p {
		margin: 1rem 0 0;
		max-width: 38rem;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.hub-block {
		padding-bottom: clamp(3rem, 2rem + 2vw, 4.5rem);
	}

	.section-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.section-more {
		color: var(--color-text-secondary);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	.section-more:hover {
		color: var(--color-text);
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1.35rem;
	}

	.work-grid__item {
		grid-column: span 12;
		min-width: 0;
	}

	.hub-empty h3 {
		margin: 0;
		font-size: 1.5rem;
	}

	.hub-btn {
		display: inline-flex;
		margin-top: 0.85rem;
		min-height: 2.5rem;
		align-items: center;
		padding: 0 1.1rem;
		border-radius: 999px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
	}

	.now-list {
		border: 1px solid var(--color-border);
		border-radius: 18px;
		overflow: hidden;
		background: color-mix(in srgb, var(--color-surface) 70%, transparent);
	}

	.now-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.05rem 1.35rem;
		border-top: 1px solid var(--color-border);
		color: inherit;
		text-decoration: none;
	}

	.now-row:first-child {
		border-top: 0;
	}

	.now-row:hover {
		background: color-mix(in srgb, var(--color-surface) 88%, transparent);
	}

	.now-row:hover .now-chevron {
		transform: translateX(3px);
	}

	.now-row time {
		display: block;
		margin-bottom: 0.2rem;
		font-size: 12px;
		color: var(--color-muted);
	}

	.now-row strong {
		display: block;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.now-row span {
		display: block;
		margin-top: 0.2rem;
		color: var(--color-text-secondary);
		font-size: 0.92rem;
	}

	.now-chevron {
		color: var(--color-muted);
		transition: transform 200ms var(--ease-out);
	}

	.hub-about {
		max-width: 36rem;
		padding-bottom: 4rem;
	}

	.hub-about .section-label {
		margin-bottom: 0.25rem;
	}

	@media (min-width: 640px) {
		.span-7,
		.span-5,
		.span-4 {
			grid-column: span 6;
		}
	}

	@media (min-width: 1024px) {
		.span-7 {
			grid-column: span 7;
		}
		.span-5 {
			grid-column: span 5;
		}
		.span-4 {
			grid-column: span 4;
		}
	}
</style>
