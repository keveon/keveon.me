---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { t } from "../../i18n/ui";

const copy = t(Astro.currentLocale);
const { entries, cacheHint } = await getEmDashCollection("products", {
	locale: Astro.currentLocale,
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const products = [...entries].sort((a, b) => {
	const order = (a.data.order ?? 0) - (b.data.order ?? 0);
	if (order !== 0) return order;
	const aTime = a.data.publishedAt?.getTime() ?? 0;
	const bTime = b.data.publishedAt?.getTime() ?? 0;
	return bTime - aTime;
});

const spans = ["span-7", "span-5", "span-4", "span-4", "span-4"];
---

<Base title={copy.productsDocumentTitle} description={copy.productsLead}>
	<header class="hub-hero">
		<p class="hub-eyebrow">{copy.productsEyebrow}</p>
		<h1>{copy.productsTitle}</h1>
		<p class="hub-lead">{copy.productsLead}</p>
	</header>

	{
		products.length === 0 ? (
			<section class="hub-empty">
				<h2>{copy.emptyWorksTitle}</h2>
				<p>{copy.emptyWorksText}</p>
				<a class="hub-btn" href="/_emdash/admin/content/products/new">
					{copy.emptyWorksAction}
				</a>
			</section>
		) : (
			<section class="work-grid" aria-label={copy.productsTitle}>
				{products.map((product, index) => (
					<div
						class:list={[
							"work-grid__item",
							index === 0 ? "span-12" : spans[(index - 1) % spans.length],
						]}
					>
						<ProductCard
							product={product}
							variant={index === 0 ? "feature" : "tile"}
							tone={index}
							headingLevel={index === 0 ? 2 : 3}
							priority={index === 0}
						/>
					</div>
				))}
			</section>
		)
	}
</Base>

<style>
	.hub-hero {
		max-width: 40rem;
		padding-block: clamp(3.5rem, 2rem + 4vw, 5rem) 2rem;
	}

	.hub-eyebrow {
		margin: 0 0 1rem;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.hub-hero h1 {
		margin: 0;
		font-size: clamp(2.5rem, 1.4rem + 3vw, 3.25rem);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.08;
	}

	.hub-lead {
		margin: 1rem 0 0;
		max-width: 36rem;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 1.25rem;
		padding-bottom: 5rem;
	}

	.work-grid__item {
		grid-column: span 12;
		min-width: 0;
	}

	.hub-empty {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		max-width: 32rem;
		padding-block: 2rem 5rem;
	}

	.hub-empty h2 {
		margin: 0;
		font-size: 1.75rem;
	}

	.hub-empty p {
		margin: 0;
		color: var(--color-text-secondary);
	}

	.hub-btn {
		display: inline-flex;
		align-items: center;
		margin-top: 0.5rem;
		min-height: 2.5rem;
		padding: 0 1.1rem;
		border-radius: 999px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
	}

	@media (min-width: 640px) {
		.span-7,
		.span-5,
		.span-4 {
			grid-column: span 6;
		}
	}

	@media (min-width: 1024px) {
		.span-12 {
			grid-column: span 12;
		}
		.span-7 {
			grid-column: span 7;
		}
		.span-5 {
			grid-column: span 5;
		}
		.span-4 {
			grid-column: span 4;
		}
	}
</style>
